# =============================================================================
# MSM CampusOS Studio — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, these are injected via GitHub Actions Secrets
# (never commit a filled .env file — it is gitignored).
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# Neon serverless Postgres connection string
# Get from: https://console.neon.tech → your project → Connection string
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require


# ─────────────────────────────────────────────────────────────────────────────
# AI — Anthropic
# Get from: https://console.anthropic.com → API Keys
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# CACHE / RATE LIMITING — Upstash Redis
# Get from: https://console.upstash.com → your Redis database → REST API tab
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC VARS — baked into the Next.js JS bundle at build time
# These must also be added as GitHub Secrets (used as Docker --build-arg)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=MSM CampusOS Studio


# ─────────────────────────────────────────────────────────────────────────────
# GITHUB ACTIONS / CI-CD ONLY
# These are NOT used by the app at runtime — only by the pipeline.
# Add them in: Repo → Settings → Secrets and variables → Actions
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Container Registry — PAT with write:packages scope
# (or leave blank and set Workflow permissions to Read & Write in repo settings)
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Linux VM — SSH access
# VM_HOST=203.0.113.42
# VM_USER=ubuntu
# VM_SSH_PASSWORD=your-vm-password
# VM_SSH_PORT=22

# VM host port that maps to container port 3000 (default: 3000)
# HOST_PORT=3000

# App URL as a GitHub Actions Variable (not secret) for environment.url display
# Set at: Repo → Settings → Secrets and variables → Actions → Variables tab
# APP_URL=https://yourdomain.com
